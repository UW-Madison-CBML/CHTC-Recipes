maintain_port_forwarding() {
    local ap_host=$1
    local job_id=$2
    local port=$3

    # Forward port local -> AP -> EP (HTCondor Job)
    ssh -N -L ${port}:localhost:${port} "${ap_host}" bash << EOFAP
unset SSH_AUTH_SOCK

# Create temporary SSH wrapper that includes port forwarding
temp_ssh=\$(mktemp)
cat > "\$temp_ssh" << 'EOFSSH'
#!/bin/bash
# \$@ contains condor's generated target options
exec ssh -N -L ${port}:localhost:${port} "\$@"
EOFSSH
chmod +x "\$temp_ssh"

# Run condor_ssh_to_job with custom wrapper
condor_ssh_to_job -auto-retry -ssh "\$temp_ssh" ${job_id}

# Cleanup on exit
rm -f "\$temp_ssh"
EOFAP

    return $?
}

# Resume existing session
resume_session() {
    local ap_host=$1
    local job_id=$2
    local port=$3

    log_info "Resuming streamlit session for job $job_id on port $port"
    log_info ""

    show_connection_info "$ap_host" "$job_id" "$port"
    maintain_port_forwarding "$ap_host" "$job_id" "$port"

    return $?
}

# Launch streamlit on the execution point
launch_job() {
    local ap_host=$1
    local job_id=$2
    local port=$3

    # Pass the launch command as an argument: docker/container-universe jobs cannot
    # allocate a PTY for a non-interactive session ("the input device is not a TTY")
    ssh "${ap_host}" "unset SSH_AUTH_SOCK; condor_ssh_to_job -auto-retry ${job_id} 'if [ -f ./launch_job.sh ]; then nohup ./launch_job.sh ${port} > agents.log 2>&1 & else export HOME=\$(pwd); nohup streamlit run app.py --server.port=${port} > agents.log 2>&1 & fi'"
}

# Wait for streamlit to write its URL to agents.log on the EP
wait_for_agents() {
    local ap_host=$1
    local job_id=$2

    echo "Waiting for streamlit to start (a container pull can take several minutes)..."
    if ssh "${ap_host}" "unset SSH_AUTH_SOCK; condor_ssh_to_job -auto-retry ${job_id} 'for i in \$(seq 1 90); do grep -q http agents.log 2>/dev/null && exit 0; sleep 10; done; exit 1'"; then
        log_success "streamlit is up"
        return 0
    fi

    log_error "Timed out waiting for streamlit to write a URL to agents.log"
    log_info "Inspect manually: ssh ${ap_host}, then: condor_ssh_to_job ${job_id} and cat agents.log"
    return 1
}

# Connect and launch streamlit
connect_and_launch() {
    local ap_host=$1
    local job_id=$2
    local port=$3

    log_info "Connecting to job $job_id with port forwarding on $port..."
    log_info ""
    log_success "Streamlit will start automatically"
    log_info "Look for the URL with token (http://127.0.0.1:$port=...)"
    log_info "Copy and paste it into your browser"
    log_info ""
    log_warn "Keep this terminal open to maintain the connection!"
    log_info ""

    # Launch Streamlit on the EP (via AP)
    echo "Starting Streamlit on port ${port}..."
    launch_job "$ap_host" "$job_id" "$port"

    wait_for_agents "$ap_host" "$job_id"
    echo ""

    # Show connection info and establish persistent forwarding
    show_connection_info "$ap_host" "$job_id" "$port"
    maintain_port_forwarding "$ap_host" "$job_id" "$port"

    return $?
}

# Show usage
show_usage() {
    cat << 'EOF'
chtc-agents - Launch Streamlit on CHTC HTCondor from your laptop

Usage:
  ./chtc-agents                    Launch new streamlit session
  ./chtc-agents resume <JobID> <Port>   Resume existing session

Environment variables:
  AP_HOST        Access point hostname (default: ap2002.chtc.wisc.edu)
  AP_USER        Username on AP (default: $USER)
  SUBMIT_FILE    Local submit file to copy (default: submit_job.sub)
  LAUNCH_SCRIPT  Local launch script to copy (default: launch_job.sh)
  SUBMIT_DIR     Remote directory on AP (default: /home/$AP_USER/chtc-agents)
  PORT_START     Port range start (default: 8889)
  PORT_END       Port range end (default: 8999)

Examples:
  # Basic usage
  ./chtc-agents

  # Different access point
  AP_HOST=ap2001.chtc.wisc.edu ./chtc-agents

  # Custom submit file
  SUBMIT_FILE=submit_job.sub ./chtc-agents

  # Custom port range
  PORT_START=9000 PORT_END=9100 ./chtc-agents

The script will:
  1. Find a port available on both your laptop and the AP
  2. Copy submit_job.sub and launch_job.sh to the AP
  3. Submit the job on the AP
  4. Wait for the job to start
  5. Connect with automatic port forwarding
  6. Launch streamlit and display the connection URL

Prerequisites:
  - SSH access to CHTC AP
  - submit_job.sub exists locally (will be copied to AP)
  - launch_job.sh exists locally (will be copied to AP)
  - Container in /staging/

EOF
}

# Main
main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        show_usage
        exit 0
    fi

    # Handle resume command
    if [[ "${1:-}" == "resume" ]]; then
        if [[ -z "${2:-}" || -z "${3:-}" ]]; then
            log_error "Resume requires JobID and Port"
            log_info "Usage: $0 resume <JobID> <Port>"
            exit 1
        fi
        local job_id=$2
        local port=$3
        local ap_connection="${AP_USER}@${AP_HOST}"

        log_info "CHTC Streamlit Launcher - Resume Mode"
        log_info "Access Point: $ap_connection"
        log_info "Job ID: $job_id"
        log_info "Port: $port"
        log_info ""

        resume_session "$ap_connection" "$job_id" "$port"
        exit $?
    fi

    local ap_connection="${AP_USER}@${AP_HOST}"

    log_info "CHTC Streamlit Launcher"
    log_info "Access Point: $ap_connection"
    log_info "Submit File: $SUBMIT_FILE"
    log_info "Launch Script: $LAUNCH_SCRIPT"
    log_info "Remote Directory: $SUBMIT_DIR"
    log_info ""

    # Check if local files exist
    if [[ ! -f "$SUBMIT_FILE" ]]; then
        log_error "Submit file not found locally: $SUBMIT_FILE"
        log_info "Please create $SUBMIT_FILE or set SUBMIT_FILE environment variable"
        exit 1
    fi

    if [[ ! -f "$LAUNCH_SCRIPT" ]]; then
        log_error "Launch script not found locally: $LAUNCH_SCRIPT"
        log_info "Please create $LAUNCH_SCRIPT or set LAUNCH_SCRIPT environment variable"
        exit 1
    fi

    # Test SSH connection
    log_info "Testing SSH connection to $ap_connection..."
    if ! ssh -o ConnectTimeout=60 "${ap_connection}" "echo ok" 2>&1 | grep -q "ok"; then
        log_error "Cannot connect to $ap_connection"
        log_info "Make sure you have SSH access and authentication set up"
        log_info "Try: ssh $ap_connection"
        exit 1
    fi
    log_success "SSH connection OK"

    # Find common available port
    local port
    port=$(find_common_port "$ap_connection" "$PORT_RANGE_START" "$PORT_RANGE_END")
    if [[ $? -ne 0 ]]; then
        log_error "Could not find available port"
        exit 1
    fi

    echo ""

    # Submit job
    local job_id
    job_id=$(submit_job "$ap_connection" "$SUBMIT_FILE" "$LAUNCH_SCRIPT" "$SUBMIT_DIR")

    echo ""

    # Wait for job to start
    wait_for_job "$ap_connection" "$job_id"

    echo ""

    # Connect and launch
    connect_and_launch "$ap_connection" "$job_id" "$port"
}

main "$@"
